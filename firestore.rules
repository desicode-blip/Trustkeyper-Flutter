rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && currentUser().roles.hasAny(['admin'])
        && currentUser().get('paused', false) != true;
    }

    function isBroker() {
      return signedIn()
        && currentUser().roles.hasAny(['broker'])
        && currentUser().approvalStatus == 'approved'
        && currentUser().get('paused', false) != true;
    }

    function hasClientRoles(data) {
      return data.roles is list
        && data.roles.size() > 0
        && data.roles.hasOnly(['broker', 'owner', 'tenant']);
    }

    function protectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'roles',
        'approvalStatus',
        'paused',
        'emailVerifiedAt',
        'accountClosure',
        'adminNotes',
        'createdAt'
      ]);
    }

    function verifiedProfileEmail() {
      return request.auth.token.get('email_verified', false) == true
        && request.resource.data.email == request.auth.token.get('email', '');
    }

    function verifiedPhoneOnlyProfile() {
      return request.auth.token.get('phone_number', '') != ''
        && request.auth.token.firebase.sign_in_provider == 'phone'
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.get('email', '') == '';
    }

    function verifiedPhoneProof(phone) {
      let token = request.auth.token;
      return token.get('phone_number', '').matches('^[+][1-9][0-9]{7,14}$')
        && token.phone_number == phone
        && (token.firebase.sign_in_provider == 'phone'
          || (token.firebase.sign_in_provider == 'custom'
            && token.get('trustkeyper_email_otp', false) == true
            && token.get('email_verified', false) == true
            && token.get('email', '') != ''
            && token.get('trustkeyper_verified_phone', '') == phone));
    }

    function isParticipant(data) {
      return isAdmin()
        || (data.keys().hasAny(['participantUids'])
          && request.auth.uid in data.participantUids
          && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || currentUser().get('paused', false) != true));
    }

    function draftFields() {
      return ['schemaVersion', 'propertyAddress', 'propertyId', 'propertyDetails',
        'owners', 'tenants', 'owner', 'tenant', 'partyNames', 'monthlyRentPaise',
        'monthlyMaintenancePaise', 'securityDepositPaise', 'startDateISO',
        'endDateISO', 'rentDueDay', 'lockInMonths', 'noticeMonths',
        'ownerBrokeragePaise', 'tenantBrokeragePaise', 'brokerageFeePaise',
        'brokeragePayer', 'effectiveDate', 'endDate', 'status', 'revision',
        'brokerUid', 'participantUids', 'createdAt', 'updatedAt'];
    }

    match /ownerCallbacks/{ownerUid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == ownerUid
        && currentUser().roles.hasAny(['owner']) && currentUser().get('paused', false) != true
        && verifiedPhoneProof(currentUser().get('phone', 'missing')));
      allow write: if false;
      match /events/{eventId} { allow read, write: if false; }
    }
    match /ownerManagers/{ownerUid} { allow read, write: if false; }
    match /agreementImports/{requestId} {
      allow read, write: if false;
      match /events/{eventId} { allow read, write: if false; }
    }
    match /agreementImportUploads/{uploadId} { allow read, write: if false; }
    match /agreementImportLimits/{uid} { allow read, write: if false; }
    match /ownerProperties/{id} { allow read, write: if false; }
    match /ownerContractUploads/{id} { allow read, write: if false; }
    match /ownerContractChallenges/{id} { allow read, write: if false; }
    match /ownerListingViews/{id} { allow read, write: if false; }
    match /ownerPropertyUploads/{id} { allow read, write: if false; }
    match /ownerPropertyLimits/{uid} { allow read, write: if false; }
    match /callbackOperations/{operationId} { allow read, write: if false; }
    match /callbackLimits/{ownerUid} { allow read, write: if false; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && hasClientRoles(request.resource.data)
        && (verifiedProfileEmail() || verifiedPhoneOnlyProfile())
        && !request.resource.data.keys().hasAny([
          'approvalStatus',
          'paused',
          'emailVerifiedAt',
          'accountClosure',
          'adminNotes'
        ]);
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && resource.data.get('paused', false) != true
          && protectedUserFieldsUnchanged()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || verifiedProfileEmail()));
      allow delete: if false;

      match /updates/{updateId} {
        allow read: if isBroker() && request.auth.uid == userId;
        allow update: if isBroker() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow create, delete: if false;
      }

      match /pushDevices/{deviceId} {
        allow read: if isBroker() && request.auth.uid == userId;
        allow create, update: if isBroker() && request.auth.uid == userId
          && deviceId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['token', 'enabled', 'platform', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 4096 && request.resource.data.enabled is bool
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /draftProgress/{draftId} {
        function ownsProgress() {
          return isBroker() && request.auth.uid == userId;
        }
        function validProgress() {
          let data = request.resource.data;
          return data.keys().hasOnly(['schemaVersion', 'draft', 'stage', 'person',
              'inputs', 'version', 'brokerUid', 'createdAt', 'updatedAt'])
            && data.schemaVersion == 1 && data.brokerUid == userId
            && data.draft is map && data.inputs is map
            && data.draft.owners is list && data.draft.owners.size() > 0
            && data.draft.owners.size() <= 20
            && data.draft.tenants is list && data.draft.tenants.size() > 0
            && data.draft.tenants.size() <= 20
            && data.draft.revision is int && data.draft.revision >= 0
            && data.stage in ['ownerCount', 'owner', 'ownerPapers', 'tenantCount',
              'tenant', 'tenantPapers', 'money', 'dates', 'periods', 'brokerage', 'review']
            && data.person is int && data.person >= 0 && data.person < 20
            && (data.stage in ['tenantCount', 'tenant', 'tenantPapers']
              ? data.person < data.draft.tenants.size()
              : data.person < data.draft.owners.size())
            && data.version is int && data.updatedAt == request.time;
        }
        function editableProgress() {
          return !exists(/databases/$(database)/documents/agreements/$(draftId))
            || (get(/databases/$(database)/documents/agreements/$(draftId)).data.brokerUid == userId
              && get(/databases/$(database)/documents/agreements/$(draftId)).data.status == 'draft'
              && get(/databases/$(database)/documents/agreements/$(draftId)).data.revision
                == request.resource.data.draft.revision);
        }
        allow read: if ownsProgress();
        allow create: if ownsProgress() && validProgress() && editableProgress()
          && request.resource.data.version == 1
          && request.resource.data.createdAt == request.time;
        allow update: if ownsProgress() && validProgress() && editableProgress()
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsProgress();
      }
    }

    match /properties/{propertyId} {
      allow read: if signedIn() && isParticipant(resource.data);
      allow create: if isBroker()
        && request.resource.data.brokerUid == request.auth.uid
        && request.resource.data.participantUids == [request.auth.uid]
        && !request.resource.data.keys().hasAny(['activeAgreementId', 'occupancyStatus', 'nextInspectionDate']);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeAgreementId', 'occupancyStatus', 'nextInspectionDate'])
        && (isAdmin() || (isBroker()
          && resource.data.brokerUid == request.auth.uid
          && request.resource.data.brokerUid == resource.data.brokerUid
          && request.resource.data.participantUids == resource.data.participantUids));
      allow delete: if false;

      match /photoChecks/{checkId} {
        allow read: if isAdmin();
        allow create, update: if false;
        allow delete: if false;
      }
    }

    match /agreements/{agreementId} {
      allow get: if (signedIn() && isParticipant(resource.data))
        || (isBroker() && !exists(/databases/$(database)/documents/agreements/$(agreementId)));
      allow list: if signedIn() && isParticipant(resource.data);
      allow create: if isBroker()
        && request.resource.data.brokerUid == request.auth.uid
        && request.resource.data.participantUids == [request.auth.uid]
        && request.resource.data.status == 'draft'
        && request.resource.data.revision == 1
        && request.resource.data.keys().hasOnly(draftFields());
      allow update: if (isBroker()
          && resource.data.brokerUid == request.auth.uid
          && request.resource.data.brokerUid == resource.data.brokerUid
          && request.resource.data.participantUids == resource.data.participantUids
          && resource.data.status == 'draft'
          && request.resource.data.status == 'draft'
          && request.resource.data.revision == resource.data.get('revision', 0) + 1
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && (resource.data.get('renewalSourceId', '') == ''
            || (request.resource.data.startDateISO == resource.data.startDateISO
              && request.resource.data.effectiveDate == resource.data.effectiveDate
              && request.resource.data.propertyId == resource.data.propertyId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(draftFields()));
      allow delete: if false;

      match /events/{eventId} {
        allow read: if signedIn()
          && isParticipant(
            get(/databases/$(database)/documents/agreements/$(agreementId)).data
          );
        allow write: if false;
      }

      match /reviews/{revision} {
        allow read: if signedIn()
          && isParticipant(get(/databases/$(database)/documents/agreements/$(agreementId)).data);
        allow write: if false;
      }
    }

    match /brokerDocumentRequests/{requestId} {
      allow read: if isBroker() && resource.data.brokerUid == request.auth.uid;
      allow write: if false;
      match /events/{eventId} {
        allow read: if isBroker() && get(/databases/$(database)/documents/brokerDocumentRequests/$(requestId)).data.brokerUid == request.auth.uid;
        allow write: if false;
      }
    }

    match /agreementInvitations/{invitationId} {
      allow read: if isBroker() && resource.data.brokerUid == request.auth.uid;
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && isParticipant(resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastFollowUp',
          'lastFollowUpAt',
          'followUpCount',
          'updatedAt'
        ]);
      allow create, delete: if false;
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && isParticipant(resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'adminActionRequested',
          'adminActionRequestedAt',
          'updatedAt'
        ]);
      allow create, delete: if false;
    }

    match /issues/{issueId} {
      allow read: if signedIn() && isParticipant(resource.data);
      allow create: if signedIn()
        && currentUser().get('paused', false) != true
        && request.resource.data.keys().hasOnly(['agreementId', 'propertyAddress',
          'participantUids', 'createdBy', 'category', 'title', 'description',
          'status', 'createdAt', 'updatedAt'])
        && request.resource.data.agreementId is string
        && exists(/databases/$(database)/documents/agreements/$(request.resource.data.agreementId))
        && request.auth.uid in get(/databases/$(database)/documents/agreements/$(request.resource.data.agreementId)).data.participantUids
        && request.resource.data.participantUids == get(/databases/$(database)/documents/agreements/$(request.resource.data.agreementId)).data.participantUids
        && request.resource.data.propertyAddress == get(/databases/$(database)/documents/agreements/$(request.resource.data.agreementId)).data.propertyAddress
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.category in ['Water', 'Electric', 'Appliance', 'Door / lock', 'Other']
        && request.resource.data.title == request.resource.data.category + ' problem'
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /documentRequests/{requestId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /moveOuts/{moveOutId} {
      allow read: if isAdmin() || (signedIn() && isParticipant(resource.data));
      allow create, update: if false;
      allow delete: if false;
      match /destinations/{personId} {
        allow read, write: if false;
      }
    }

    match /moveOutOperations/{operationId} { allow read, write: if false; }
    match /moveOutKeyChallenges/{challengeId} { allow read, write: if false; }
    match /moveOutKeyLimits/{limitId} { allow read, write: if false; }
    match /moveOutRefundRequests/{refundId} { allow read, write: if false; }

    match /tenancies/{agreementId} {
      allow read: if signedIn() && currentUser().get('paused', false) != true
        && isParticipant(get(/databases/$(database)/documents/agreements/$(agreementId)).data);
      allow write: if false;
      match /rentFollowUps/{periodId} {
        allow read, write: if false;
      }
    }

    match /tenancyOperations/{operationId} {
      allow read, write: if false;
    }

    match /keyHandoverChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /notificationRequests/{notificationId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /adminSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ---- TrustKeeper 2 (broker app + owner/tenant web). docs/TRUSTKEEPER2-BACKEND.md ----
    // Any signed-in phone/email user may be a TK2 broker, owner or tenant; access
    // is by uid fields on each document, not by the main app's users/{uid} roles.

    function tk2Uid() {
      return request.auth.uid;
    }

    function tk2Unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function tk2Invite(id) {
      return get(/databases/$(database)/documents/tk2Invites/$(id)).data;
    }

    // Broker profile: name, phone, default token, contacts, account details.
    match /tk2Brokers/{uid} {
      allow read, write: if signedIn() && tk2Uid() == uid;
    }

    function tk2RecipientProof(recipient) {
      return recipient is string && recipient != '' && (
        verifiedPhoneProof(recipient)
        || (request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '').lower() == recipient));
    }

    function tk2BoundInvite(invite, broker, owner) {
      return invite.get('recipient', '') != '' && invite.brokerUid == broker
        && invite.get('ownerUid', null) == owner;
    }

    function tk2BoundListing(listingId, inviteId, broker, owner) {
      let listing = getAfter(/databases/$(database)/documents/tk2Private/$(listingId)).data;
      return listing.brokerUid == broker && listing.ownerUid == owner && listing.inviteId == inviteId;
    }

    // The link locates an invite. The broker's selected recipient verifies
    // their identity before seeing its details or claiming it.
    match /tk2Invites/{id} {
      allow get: if signedIn() && (resource.data.brokerUid == tk2Uid()
        || resource.data.get('recipient', '') != ''
          && (resource.data.get('ownerUid', null) == tk2Uid()
            || resource.data.get('ownerUid', null) == null && tk2RecipientProof(resource.data.recipient)));
      allow list: if signedIn() && resource.data.brokerUid == tk2Uid();
      allow create: if signedIn() && request.resource.data.brokerUid == tk2Uid()
        && request.resource.data.keys().hasOnly(['brokerUid', 'brokerName', 'brokerPhone', 'houseName', 'ownerName', 'recipient', 'createdAt'])
        && request.resource.data.recipient is string && request.resource.data.recipient.size() <= 254
        && (request.resource.data.recipient.matches('^[+][1-9][0-9]{7,14}$')
          || request.resource.data.recipient.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'));
      allow update: if signedIn() && resource.data.brokerUid != tk2Uid()
        && request.resource.data.ownerUid == tk2Uid()
        && resource.data.get('recipient', '') != ''
        && (resource.data.get('ownerUid', null) == tk2Uid()
          || resource.data.get('ownerUid', null) == null && tk2RecipientProof(resource.data.recipient))
        && (resource.data.get('listingId', null) == null || tk2Unchanged(['listingId']))
        && (request.resource.data.get('listingId', null) == null
          || tk2BoundListing(request.resource.data.listingId, id, resource.data.brokerUid, tk2Uid()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'ownerName', 'listingId', 'updatedAt']);
      allow delete: if signedIn() && resource.data.brokerUid == tk2Uid();
    }

    // Public listing: only what tenants may see (tk2PublicPayload) + brokerUid,
    // ownerUid, active, updatedAt. Door no., owner, keys and notes never go here.
    match /tk2Listings/{id} {
      function publicOnly() {
        return request.resource.data.keys().hasOnly(['id', 't', 'a', 'r', 'rent', 'mi', 'rn', 'm', 'd', 'b', 'bd', 'f', 's', 'fl', 'tf',
          'fc', 'w', 'pt', 'av', 'vd', 'vf', 'vt', 'fee', 'tk', 'bn', 'bp', 'ph', 'brokerUid', 'ownerUid', 'inviteId', 'active', 'updatedAt'])
          && request.resource.data.id == id
          && request.resource.data.fee is int && request.resource.data.fee >= 0 && request.resource.data.fee <= 500;
      }
      function ownerOfInvite() {
        let invite = tk2Invite(request.resource.data.inviteId);
        return tk2BoundInvite(invite, request.resource.data.brokerUid, tk2Uid())
          && request.resource.data.ownerUid == tk2Uid() && invite.get('listingId', null) in [null, id];
      }
      allow get: if true;
      allow list: if signedIn() && resource.data.brokerUid == tk2Uid();
      allow create: if signedIn() && publicOnly() && (
        request.resource.data.brokerUid == tk2Uid()
          && request.resource.data.get('ownerUid', null) == null && request.resource.data.get('inviteId', null) == null
        || request.resource.data.get('inviteId', null) is string && ownerOfInvite());
      allow update: if signedIn() && publicOnly() && tk2Unchanged(['brokerUid', 'ownerUid', 'inviteId'])
        && (resource.data.brokerUid == tk2Uid() || request.resource.data.get('inviteId', null) is string && ownerOfInvite());
      allow delete: if signedIn() && resource.data.brokerUid == tk2Uid();
    }

    // The full listing for the broker (and the owner who added it): door no.,
    // owner, keys, notes, off-market reason, owner answers.
    match /tk2Private/{id} {
      function listingDoc() {
        return getAfter(/databases/$(database)/documents/tk2Listings/$(id)).data;
      }
      function inviteOwner(data) {
        let inviteId = data.get('inviteId', null);
        return inviteId is string && data.get('ownerUid', null) == tk2Uid()
          && tk2BoundInvite(tk2Invite(inviteId), data.brokerUid, tk2Uid());
      }
      allow get: if signedIn() && (resource.data.brokerUid == tk2Uid() || inviteOwner(resource.data));
      allow list: if signedIn() && resource.data.brokerUid == tk2Uid();
      allow create: if signedIn() && request.resource.data.brokerUid == listingDoc().brokerUid
        && request.resource.data.get('ownerUid', null) == listingDoc().get('ownerUid', null)
        && request.resource.data.get('inviteId', null) == listingDoc().get('inviteId', null)
        && (request.resource.data.brokerUid == tk2Uid()
          || !request.resource.data.keys().hasAny(['ownerContact']) && inviteOwner(request.resource.data)
            && getAfter(/databases/$(database)/documents/tk2Invites/$(request.resource.data.inviteId)).data.listingId == id);
      allow update: if signedIn() && tk2Unchanged(['brokerUid', 'ownerUid', 'inviteId'])
        && (resource.data.brokerUid == tk2Uid()
          || tk2Unchanged(['ownerContact']) && inviteOwner(resource.data));
      allow delete: if signedIn() && resource.data.brokerUid == tk2Uid();
    }

    // Paid visit. The tenant books it; the broker cancels / marks "did not come"
    // or adds the gate pass; "visit done" is only set by tk2ConfirmVisit.
    match /tk2Visits/{id} {
      function listingDoc() {
        return get(/databases/$(database)/documents/tk2Listings/$(request.resource.data.listingId)).data;
      }
      function onlyStatus(to) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && resource.data.status == 'booked' && request.resource.data.status in to;
      }
      function visitCode() {
        return getAfter(/databases/$(database)/documents/tk2Visits/$(id)/secret/code).data.code;
      }
      allow get: if signedIn() && tk2Uid() in [resource.data.brokerUid, resource.data.customerUid];
      allow list: if signedIn() && (resource.data.brokerUid == tk2Uid() || resource.data.customerUid == tk2Uid());
      allow create: if signedIn() && request.resource.data.customerUid == tk2Uid()
        && request.resource.data.status == 'booked'
        && request.resource.data.brokerUid == listingDoc().brokerUid
        && listingDoc().get('active', true) == true
        && request.resource.data.fee == listingDoc().fee
        && request.resource.data.at is int
        && verifiedPhoneProof(request.auth.token.get('phone_number', ''))
        && request.resource.data.customerPhone == request.auth.token.phone_number
        && request.resource.data.createdAt == request.time
        && visitCode().matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['listingId', 'brokerUid', 'customerUid', 'customerName', 'customerPhone', 'at', 'fee', 'status', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && (
        resource.data.brokerUid == tk2Uid() && (onlyStatus(['cancelled', 'noShow'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gatePass', 'updatedAt']))
        || resource.data.customerUid == tk2Uid() && (
          onlyStatus(['customerCancelled']) && request.time < resource.data.createdAt + duration.value(5, 'm')
          || onlyStatus(['customerCancelledLate']) && request.time >= resource.data.createdAt + duration.value(5, 'm')));
      allow delete: if false;

      // The 4-digit visit code: only the tenant sees it; the broker types it in
      // and tk2ConfirmVisit checks it on the server.
      match /secret/code {
        allow create: if signedIn() && getAfter(/databases/$(database)/documents/tk2Visits/$(id)).data.customerUid == tk2Uid()
          && request.resource.data.keys().hasOnly(['code']) && request.resource.data.code.matches('^[0-9]{4}$');
        allow get: if signedIn() && get(/databases/$(database)/documents/tk2Visits/$(id)).data.customerUid == tk2Uid();
        allow update, delete, list: if false;
      }
    }

    // Tenant journey per house (step, liked, details for the agreement).
    // id = <tenant uid>_<listing id>. The broker of the house can read it.
    match /tk2Trips/{id} {
      allow get, list: if signedIn() && tk2Uid() in [resource.data.customerUid, resource.data.brokerUid];
      allow create, update: if signedIn() && request.resource.data.customerUid == tk2Uid()
        && id == tk2Uid() + '_' + request.resource.data.listingId
        && request.resource.data.brokerUid == get(/databases/$(database)/documents/tk2Listings/$(request.resource.data.listingId)).data.brokerUid
        && (resource == null || tk2Unchanged(['customerUid', 'brokerUid', 'listingId']));
      allow delete: if false;
    }

    // One finalised house, token to moved in (docs/TRUSTKEEPER2-BACKEND.md §8).
    // Each person writes only their own part: 'b' broker, 't' tenant, 'o' owner.
    match /tk2Deals/{id} {
      function onlyKeys(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      function mine() {
        return resource.data.brokerUid == tk2Uid() || resource.data.tenantUid == tk2Uid()
          || resource.data.get('verifiedOwnerUid', null) == tk2Uid();
      }
      function intendedOwner() {
        let listing = get(/databases/$(database)/documents/tk2Private/$(resource.data.listingId)).data;
        let inviteId = listing.get('inviteId', null);
        return listing.brokerUid == resource.data.brokerUid && (
          (inviteId is string && listing.get('ownerUid', null) == tk2Uid()
            && tk2BoundInvite(tk2Invite(inviteId), listing.brokerUid, tk2Uid()))
          || (inviteId == null && listing.get('ownerUid', null) == null
            && tk2RecipientProof(listing.get('ownerContact', ''))));
      }
      function tenantCompletionFields() {
        return ['tokenPaid', 'tokenAt', 'paid', 'paidAt', 'signed', 'signedAt'];
      }
      function ownerCompletionFields() {
        return ['feePaid', 'feeAt', 'brokPaid', 'paidAt', 'signed', 'signedAt', 'rep'];
      }
      function clientPart(part, protectedFields) {
        return request.resource.data[part] is map
          && !request.resource.data[part].keys().hasAny(protectedFields);
      }
      allow get, list: if signedIn() && mine();
      // Cloud deal creation is reserved for the backend payment workflow.
      allow create: if false;
      allow update: if signedIn() && (
        resource.data.brokerUid == tk2Uid() && onlyKeys(['b', 'ownerName', 'ownerPhone', 'updatedAt'])
        || resource.data.tenantUid == tk2Uid() && onlyKeys(['t', 'updatedAt']) && clientPart('t', tenantCompletionFields())
        || resource.data.get('verifiedOwnerUid', null) == tk2Uid() && onlyKeys(['o', 'updatedAt']) && clientPart('o', ownerCompletionFields())
        || resource.data.get('verifiedOwnerUid', null) == null && tk2Uid() != resource.data.tenantUid && tk2Uid() != resource.data.brokerUid
          && request.resource.data.verifiedOwnerUid == tk2Uid() && onlyKeys(['verifiedOwnerUid', 'updatedAt']) && intendedOwner());
      allow delete: if false;
    }

    // A society's move-in steps, shared by brokers. The first broker creates
    // it; later edits wait in 'proposed' until the TrustKeyper team checks
    // them (the team writes 'steps' and 'checked' from the console).
    match /tk2Playbooks/{slug} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.brokerUid == tk2Uid() && request.resource.data.checked == false
        && request.resource.data.steps is list && request.resource.data.steps.size() <= 30;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposed', 'updatedAt'])
        && request.resource.data.proposed.brokerUid == tk2Uid() && request.resource.data.proposed.steps.size() <= 30;
      allow delete, list: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
