{
  "name": "trustkeyper",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22" },
  "scripts": {
    "setup:backend": "npm --prefix functions ci",
    "setup:flutter": "cd apps/flutter_app && flutter pub get",
    "dev:mobile": "cd apps/flutter_app && flutter run",
    "dev:web": "cd apps/flutter_app && flutter run -d chrome",
    "dev:ui-test": "cd apps/flutter_app && flutter run -t lib/ui_test_main.dart --dart-define=TRUSTKEYPER_UI_TEST=true --dart-define=TRUSTKEYPER_EMAIL_OTP_ENABLED=false",
    "analyze": "cd apps/flutter_app && flutter analyze",
    "test": "npm run test:backend && npm run test:tooling",
    "test:backend": "npm --prefix functions test",
    "test:tooling": "node --test scripts/test/*.test.cjs && node scripts/test-web-bootstrap.cjs",
    "test:flutter": "cd apps/flutter_app && flutter test --concurrency=1",
    "test:rules": "firebase emulators:exec --project demo-trustkeyper-rules --only auth,firestore,storage \"npm --prefix functions run test:rules\"",
    "check:web-sdk": "node scripts/check-firebase-web-sdk.cjs",
    "check:ios": "node scripts/check-ios-configuration.cjs",
    "build:web": "npm run check:web-sdk && cd apps/flutter_app && flutter build web --release --no-wasm-dry-run"
  }
}
