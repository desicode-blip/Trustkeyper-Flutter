rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('paused', false) != true);
    }

    function isAllowedDocument() {
      return request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)|application/pdf');
    }

    function verifiedPhoneProof(phone) {
      let token = request.auth.token;
      return token.get('phone_number', '').matches('^[+][1-9][0-9]{7,14}$')
        && token.phone_number == phone
        && (token.firebase.sign_in_provider == 'phone'
          || (token.firebase.sign_in_provider == 'custom'
            && token.get('trustkeyper_email_otp', false) == true
            && token.get('email_verified', false) == true
            && token.get('email', '') != ''
            && token.get('trustkeyper_verified_phone', '') == phone));
    }

    function isAgreementParticipant(agreementId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('paused', false) != true
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/agreements/$(agreementId)
        ).data.participantUids;
    }

    match /repairUploads/{userId}/{reportId}/{index} {
      function context() {
        return firestore.get(/databases/(default)/documents/repairReportUploads/$(reportId)).data;
      }
      function canUpload() {
        return signedIn() && request.auth.uid == userId
          && reportId.matches('[a-f0-9]{32}') && index in ['0', '1', '2', '3']
          && firestore.get(/databases/(default)/documents/users/$(userId)).data.get('paused', false) != true
          && context().createdBy == userId && context().status == 'uploading'
          && context().expiresAtMs > request.time.toMillis();
      }
      allow read, delete: if canUpload();
      allow create, update: if canUpload() && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png'];
    }

    match /issues/{issueId}/photos/{index} {
      allow read, write: if false;
    }

    match /repairCompletionUploads/{adminUid}/{uploadId}/{slot} {
      function allowed() {
        let upload = firestore.get(/databases/(default)/documents/repairCompletionUploads/$(uploadId)).data;
        let profile = firestore.get(/databases/(default)/documents/users/$(adminUid)).data;
        return signedIn() && request.auth.uid == adminUid && profile.roles.hasAny(['admin'])
          && profile.get('paused', false) != true && upload.adminUid == adminUid
          && upload.status == 'uploading' && upload.expiresAtMs > request.time.toMillis()
          && (slot in ['bill', 'after'] || slot == 'before' && upload.includeBefore == true);
      }
      allow read, delete: if allowed();
      allow create, update: if allowed() && isAllowedDocument()
        && (slot == 'bill' || request.resource.contentType in ['image/jpeg', 'image/png']);
    }

    match /issues/{issueId}/evidence/{allPaths=**} {
      allow read, write: if false;
    }

    match /agreementCopyUploads/{adminUid}/{uploadId}/agreement.pdf {
      function allowed() {
        let upload = firestore.get(/databases/(default)/documents/agreementCopyUploads/$(uploadId)).data;
        let profile = firestore.get(/databases/(default)/documents/users/$(adminUid)).data;
        return signedIn() && request.auth.uid == adminUid && profile.roles.hasAny(['admin'])
          && profile.get('paused', false) != true && upload.adminUid == adminUid
          && upload.status == 'uploading' && upload.expiresAtMs > request.time.toMillis();
      }
      allow read, delete: if allowed();
      allow create, update: if allowed() && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024;
    }

    match /agreementCopies/{allPaths=**} {
      allow read, write: if false;
    }
    match /ownerContractUploads/{uid}/{uploadId}/contract.pdf {
      function allowed() {
        let data = firestore.get(/databases/(default)/documents/ownerContractUploads/$(uploadId)).data;
        let profile = firestore.get(/databases/(default)/documents/users/$(uid)).data;
        return signedIn() && request.auth.uid == uid && data.uid == uid
          && profile.roles.hasAny(['admin']) && profile.get('paused', false) != true
          && data.status == 'uploading' && data.expiresAtMs > request.time.toMillis();
      }
      allow read, delete: if false;
      allow create, update: if allowed() && request.resource.contentType == 'application/pdf'
        && request.resource.size == firestore.get(/databases/(default)/documents/ownerContractUploads/$(uploadId)).data.spec.size
        && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024;
    }
    match /ownerContractFiles/{allPaths=**} { allow read, write: if false; }

    match /agreementImportUploads/{uid}/{uploadId}/{index} {
      function grant() {
        return firestore.get(/databases/(default)/documents/agreementImportUploads/$(uploadId)).data;
      }
      function authorized() {
        let profile = firestore.get(/databases/(default)/documents/users/$(uid)).data;
        let data = grant();
        return signedIn() && request.auth.uid == uid && data.uid == uid
          && data.status == 'uploading' && data.expiresAtMs > request.time.toMillis()
          && profile.get('paused', false) != true
          && (data.kind == 'signed' ? profile.roles.hasAny(['admin'])
            : profile.roles.hasAny(['broker']) && profile.approvalStatus == 'approved'
              && verifiedPhoneProof(profile.phone));
      }
      allow read, delete: if false;
      allow create, update: if index.matches('[0-9]|[1-3][0-9]') && authorized()
        && int(index) < grant().specs.size()
        && request.resource.size == grant().specs[int(index)].size
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == grant().specs[int(index)].contentType;
    }
    match /agreementImportFiles/{allPaths=**} { allow read, write: if false; }
    match /ownerPropertyUploads/{uid}/{uploadId}/{index} {
      function grant() {
        return firestore.get(/databases/(default)/documents/ownerPropertyUploads/$(uploadId)).data;
      }
      function authorized() {
        let profile = firestore.get(/databases/(default)/documents/users/$(uid)).data;
        let data = grant();
        return signedIn() && request.auth.uid == uid && data.uid == uid
          && data.status == 'uploading' && data.expiresAtMs > request.time.toMillis()
          && profile.get('paused', false) != true
          && (data.get('admin', false) == true ? profile.roles.hasAny(['admin'])
            : profile.roles.hasAny(['owner']) && verifiedPhoneProof(profile.phone));
      }
      allow read, delete: if false;
      allow create, update: if index.matches('[0-4]') && authorized()
        && int(index) < grant().specs.size() && request.resource.size == grant().specs[int(index)].size
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png']
        && request.resource.contentType == grant().specs[int(index)].contentType;
    }
    match /ownerPropertyPhotos/{allPaths=**} { allow read, write: if false; }

    match /users/{userId}/documents/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isAllowedDocument();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /brokerDocumentRequests/{requestId}/{section}/{uploadId}/{kind} {
      function requestData() {
        return firestore.get(/databases/(default)/documents/brokerDocumentRequests/$(requestId)).data;
      }
      function correctPhone(data) {
        return signedIn() && verifiedPhoneProof(data.phone)
          && data.expiresAtMs > request.time.toMillis() && data.status != 'revoked';
      }
      function correctKind(data) {
        return (data.type == 'aadhaar' && kind in ['aadhaarFront', 'aadhaarBack'])
          || (data.type == 'pan' && kind == 'pan') || (data.type == 'bank' && kind == 'bankProof')
          || (data.type == 'all' && kind in ['aadhaarFront', 'aadhaarBack', 'pan', 'bankProof']);
      }
      function uploadAllowed(data) {
        return section == 'uploads' && correctPhone(data) && correctKind(data)
          && data.status in ['created', 'shared', 'seen', 'unclear']
          && data.currentUploadUid == request.auth.uid && data.currentUploadId == uploadId
          && kind in data.get('uploadSlots', ['aadhaarFront', 'aadhaarBack', 'pan', 'bankProof'])
          && data.uploadExpiresAtMs > request.time.toMillis();
      }
      allow read: if signedIn() && correctKind(requestData())
        && ((section == 'submissions' && requestData().get('submission', {}).get('uploadId', '') == uploadId
          && (request.auth.uid == requestData().brokerUid
            || (correctPhone(requestData()) && requestData().recipientUid == request.auth.uid)))
          || uploadAllowed(requestData()));
      allow create, update: if uploadAllowed(requestData()) && isAllowedDocument();
      allow delete: if uploadAllowed(requestData());
    }

    match /agreements/{agreementId}/{allPaths=**} {
      allow read: if isAgreementParticipant(agreementId);
      allow write: if false;
    }

    match /inspectionUploads/{uid}/{checkId}/photo {
      function activeUpload() {
        let data = firestore.get(/databases/(default)/documents/inspectionUploads/$(checkId)).data;
        return signedIn() && request.auth.uid == uid && data.uid == uid
          && data.status == 'uploading' && data.expiresAtMs > request.time.toMillis()
          && firestore.get(/databases/(default)/documents/users/$(uid)).data.get('paused', false) != true;
      }
      allow read, delete: if activeUpload();
      allow create, update: if activeUpload() && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png'];
    }

    match /inspectionPhotos/{allPaths=**} {
      allow read, write: if false;
    }

    match /properties/{propertyId}/photoChecks/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
